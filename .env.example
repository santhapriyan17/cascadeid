# Database
DATABASE_URL=postgresql+psycopg2://cascadeid:password@localhost:5432/cascadeid
DATABASE_POOL_SIZE=10

# Ethereum provider (choose one or leave blank for file-only mode)
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
ETH_WS_URL=wss://mainnet.infura.io/ws/v3/YOUR_KEY

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production

# Mode: LOCAL | EXPERIMENT | REPLAY | LIVE
CASCADEID_MODE=LOCAL

# Feature flags
ENABLE_XGBOOST=false
ENABLE_REDIS_CACHE=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
